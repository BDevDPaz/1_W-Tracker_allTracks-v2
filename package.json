{
  "name": "w-tracker",
  "version": "2.0.0",
  "private": true,
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "jest --watchAll=false",
    "test:coverage": "jest --coverage",
    "quality": "npm run lint && npm run typecheck && npm test",
    "audit:deps": "depcheck",
    "audit:unused": "ts-prune",
    "audit:imports": "dpdm App.tsx && dpdm src/**/*.ts",
    "audit:cycles": "madge --extensions ts,tsx --circular src",
    "audit:orphans": "madge --extensions ts,tsx --orphans src",
    "audit:architecture": "depcruise src",
    "audit:security": "npm audit",
    "audit:security:strict": "audit-ci",
    "audit": "npm run audit:deps && npm run audit:unused",
    "audit:full": "npm run audit && npm run audit:imports && npm run audit:cycles && npm run audit:orphans && npm run audit:architecture && npm run audit:security",
    "fix": "npm run lint:fix && npm run format",
    "check": "npm run quality && npm run audit:full"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-navigation/bottom-tabs": "6.5.11",
    "@react-navigation/native": "6.1.9",
    "@react-navigation/native-stack": "6.9.17",
    "expo": "^54.0.0",
    "expo-asset": "~12.0.14",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-font": "~14.0.12",
    "expo-location": "~19.0.8",
    "expo-mail-composer": "~15.0.8",
    "expo-notifications": "~0.32.17",
    "expo-print": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-sqlite": "~16.0.10",
    "expo-task-manager": "~14.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-worklets": "0.5.1",
    "zustand": "4.5.4"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/jest": "29.5.14",
    "@types/react": "~19.1.10",
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "@typescript-eslint/parser": "8.67.0",
    "@typescript-eslint/type-utils": "8.67.0",
    "@typescript-eslint/utils": "8.67.0",
    "audit-ci": "^7.1.0",
    "babel-plugin-module-resolver": "5.0.3",
    "depcheck": "^1.4.7",
    "dependency-cruiser": "^18.2.0",
    "dpdm": "^4.3.0",
    "eslint": "8.57.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-native": "5.0.0",
    "jest-expo": "~54.0.18",
    "madge": "^7.0.0",
    "prettier": "^3.9.6",
    "source-map-explorer": "^2.5.3",
    "ts-prune": "^0.10.3",
    "typescript": "~5.9.2"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  }
}
